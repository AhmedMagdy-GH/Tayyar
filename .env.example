# Documentation only: Spring Boot does not automatically load this file.
# The checked-in password values are deliberately weak local Compose examples, not secrets.
# Use real secret injection for any non-local environment.
DB_URL=jdbc:postgresql://localhost:5432/tayyar
DB_USERNAME=tayyar_app
DB_PASSWORD=tayyar-local-runtime
# Leave migrations disabled until the target schema and grants are inspected.
DB_MIGRATIONS_ENABLED=false
# Required only when using the migrate Spring profile:
DB_MIGRATION_USERNAME=tayyar_migrator
DB_MIGRATION_PASSWORD=tayyar-local-migrator

# Optional local Docker Compose overrides. Compose works without this file.
# These deliberately weak example values are for local development only. Never reuse them.
# The PostgreSQL superuser credential is visible only to the database container.
POSTGRES_SUPERUSER_PASSWORD=tayyar-local-postgres
DB_NAME=tayyar
BACKEND_HOST_PORT=8080
CONTAINER_PORT=8080

# Identity defaults; durations use Spring duration syntax.
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_LIFETIME=12h
# Attempts per fixed 15-minute window. Login checks both IP and email keys.
AUTH_LOGIN_LIMIT=20
AUTH_REGISTRATION_LIMIT=5
AUTH_CSRF_LIMIT=60
# Authenticated checkout attempts per customer per fixed 15-minute window.
CHECKOUT_LIMIT=20

# Empty means same-origin only. Production entries must be comma-separated HTTPS origins.
ALLOWED_FRONTEND_ORIGINS=
MAX_REQUEST_BODY=1MB
SHUTDOWN_TIMEOUT=30s
SERVER_CONNECTION_TIMEOUT=10s
MAX_REQUEST_HEADER_SIZE=16KB
