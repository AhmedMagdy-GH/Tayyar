# Documentation only: Spring Boot does not automatically load this file.
# Supply values through your shell, IDE environment, or deployment secret store.
DB_URL=jdbc:postgresql://localhost:5432/tayyar
DB_USERNAME=tayyar_app
DB_PASSWORD=
# Leave migrations disabled until the target schema and grants are inspected.
DB_MIGRATIONS_ENABLED=false
# Required only when using the migrate Spring profile:
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=

# Identity defaults; durations use Spring duration syntax.
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_LIFETIME=12h
# Attempts per fixed 15-minute window. Login checks both IP and email keys.
AUTH_LOGIN_LIMIT=20
AUTH_REGISTRATION_LIMIT=5
AUTH_CSRF_LIMIT=60
